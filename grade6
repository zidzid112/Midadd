<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>مِداد | نافس — الصف السادس الابتدائي</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#e8f3ec;--grid:rgba(15,122,74,.08);--paper:#fbfefc;--ink:#0f2a1c;--muted:#4f6b5a;--rule:#c9dccf;--g:#0f7a4a;--ong:#fff;--mark:#ffd93d;--ok:#12805a;--okbg:#d8f2e4;--bad:#c23434;--badbg:#fbe0e0;
--ar:"IBM Plex Sans Arabic","Segoe UI",Tahoma,Arial,sans-serif;--en:"Bricolage Grotesque","Segoe UI",system-ui,Arial,sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1a12;--grid:rgba(111,214,160,.07);--paper:#12261b;--ink:#e6f5ec;--muted:#9bb8a7;--rule:#25402f;--g:#6fd6a0;--ong:#0b1a12;--ok:#5fe0a5;--okbg:#12382a;--bad:#ff8686;--badbg:#3d1c26}}
:root[data-theme="dark"]{--bg:#0b1a12;--grid:rgba(111,214,160,.07);--paper:#12261b;--ink:#e6f5ec;--muted:#9bb8a7;--rule:#25402f;--g:#6fd6a0;--ong:#0b1a12;--ok:#5fe0a5;--okbg:#12382a;--bad:#ff8686;--badbg:#3d1c26}
html{scroll-padding-top:env(safe-area-inset-top,0px);background:var(--bg);height:100%}*,*::before,*::after{box-sizing:inherit}
body{margin:0;min-height:100%;background-color:var(--bg);color:var(--ink);font-family:var(--ar);font-size:17px;line-height:1.65;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:26px 26px;-webkit-text-size-adjust:100%}
button,input{font:inherit;color:inherit}button{cursor:pointer}:focus-visible{outline:3px solid var(--g);outline-offset:2px}
.wrap{max-width:640px;margin:0 auto;padding:20px 16px 48px}.mk{background:linear-gradient(transparent 52%,var(--mark) 52% 90%,transparent 90%);padding:0 2px}
h1{font-size:clamp(30px,8vw,42px);line-height:1.2;margin:14px 0 10px}h2{margin:0 0 8px;font-size:21px}.lead{color:var(--muted);margin:0 0 18px}
.btn{border:1.5px solid var(--ink);background:var(--paper);border-radius:10px;padding:12px 18px;font-weight:600;box-shadow:0 3px 0 var(--ink);min-height:48px;transition:transform .08s,box-shadow .08s}
.btn:active{transform:translateY(3px);box-shadow:none}.btn.p{background:var(--pb,var(--g));color:var(--pt,var(--ong))}.btn.b{display:block;width:100%;margin-top:14px}.btn.gh{box-shadow:none;border-color:var(--rule);color:var(--muted)}
.row{display:flex;gap:10px;flex-wrap:wrap}.row .btn{flex:1 1 150px}
.card{display:block;width:100%;text-align:start;background:var(--paper);border:1.5px solid var(--ink);border-radius:14px;padding:16px;margin-bottom:12px;box-shadow:0 4px 0 var(--ink);animation:rise .3s ease both}
button.card:active{transform:translateY(3px);box-shadow:none}.card small{display:block;color:var(--muted);font-size:14.5px}.card b{font-size:19px}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.top{display:flex;justify-content:space-between;align-items:center}.back{background:none;border:0;color:var(--g);font-weight:700;padding:8px 2px;min-height:44px}
.tabs{display:grid;grid-template-columns:repeat(3,1fr);border:1.5px solid var(--ink);border-radius:10px;overflow:hidden;background:var(--paper);margin:12px 0 16px}
.tabs button{background:none;border:0;padding:11px 2px;font-weight:600;min-height:46px;border-inline-start:1.5px solid var(--ink)}.tabs button:first-child{border-inline-start:0}.tabs [aria-selected=true]{background:var(--mark);color:#1b1b1b}
.bar{height:12px;background:var(--paper);border:1.5px solid var(--ink);border-radius:4px;overflow:hidden}.bar i{display:block;height:100%;background:var(--mark);border-inline-end:1.5px solid var(--ink);transition:width .4s}
.pass{background:var(--paper);border:1.5px dashed var(--ink);border-radius:12px;padding:12px 14px;margin:0 0 14px;font-size:16px}
.opt{display:block;width:100%;margin-top:10px;background:var(--paper);border:1.5px solid var(--ink);border-radius:10px;padding:13px 16px;text-align:start;min-height:54px;box-shadow:0 3px 0 var(--ink)}
.opt:disabled{cursor:default;color:var(--ink)}.opt.ok{background:var(--okbg);border-color:var(--ok);color:var(--ok);font-weight:700}.opt.bad{background:var(--badbg);border-color:var(--bad);color:var(--bad)}
.fb{margin-top:14px;background:var(--paper);border:1.5px solid var(--ink);border-radius:12px;padding:12px 14px}.fb.ok b{color:var(--ok)}.fb.no b{color:var(--bad)}
.fc{background:var(--paper);border:1.5px solid var(--ink);border-radius:16px;min-height:200px;padding:20px;display:grid;place-items:center;text-align:center;font-size:24px;font-weight:700;box-shadow:0 5px 0 var(--ink);cursor:pointer;width:100%;animation:flip .22s ease}
@keyframes flip{from{transform:scaleY(.9);opacity:.5}to{transform:none;opacity:1}}
.score{font-family:var(--en);font-weight:800;font-size:64px;line-height:1;direction:ltr;text-align:center}
.in{width:100%;font:600 24px var(--en);letter-spacing:3px;text-align:center;direction:ltr;padding:14px;border:1.5px solid var(--ink);border-radius:10px;background:var(--paper)}
.msg{min-height:1.7em;margin:8px 0 0;font-weight:600}.foot{margin-top:28px;color:var(--muted);font-size:14.5px;border-top:1px solid var(--rule);padding-top:12px}
label.chk{display:flex;gap:10px;align-items:center;margin:10px 0}label.chk input{width:22px;height:22px;accent-color:var(--g)}select{width:100%;padding:12px;border:1.5px solid var(--ink);border-radius:10px;background:var(--paper);font:inherit}
.tm{font-family:var(--en);font-weight:800;direction:ltr}.lock{opacity:.75}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style><style id="theme">:root{--bg:#fbf4dc;--grid:rgba(138,100,0,.10);--paper:#fffdf4;--ink:#2a2100;--muted:#6b5a2a;--rule:#e4d8a8;--g:#8a6400;--ong:#fff;--pb:#ffd93d;--pt:#1b1b1b;--mark:#ffd93d}@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1c1700;--grid:rgba(255,217,61,.07);--paper:#262000;--ink:#fff4c4;--muted:#cdbd7a;--rule:#4a3f10;--g:#ffd93d;--ong:#1b1b1b;--pb:#ffd93d;--pt:#1b1b1b}}:root[data-theme="dark"]{--bg:#1c1700;--grid:rgba(255,217,61,.07);--paper:#262000;--ink:#fff4c4;--muted:#cdbd7a;--rule:#4a3f10;--g:#ffd93d;--ong:#1b1b1b;--pb:#ffd93d;--pt:#1b1b1b}</style></head><body><div class="wrap" id="app"></div>
<script>
window.__boot=function(D){
var KEY="midad-g6-v1",st={best:{},tries:{}},S={v:"home"},T=null,sets={},LV=["","سهل","متوسط","صعب"];
try{var r=localStorage.getItem(KEY);if(r){var p=JSON.parse(r);if(p&&p.best)st=p;if(!st.tries)st.tries={}}}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify(st))}catch(e){}}
D.grades.forEach(function(g){g.sets.forEach(function(s){s.gid=g.id;s.gname=g.name;sets[s.id]=s})});
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return{"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]})}
function shuf(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1)),t=a[i];a[i]=a[j];a[j]=t}return a}
function calcScore(qs,ans){var c=0;qs.forEach(function(q,i){if(ans[i]===q.a)c++});return{correct:c,wrong:qs.length-c,total:qs.length,pct:qs.length?Math.round(c/qs.length*100):0}}
function go(v,x){clearInterval(T);S.v=v;for(var k in x)S[k]=x[k];draw();window.scrollTo(0,0)}
var DISC='<p class="foot">محتوى تدريبي مستقل من تأليفنا، وغير تابع رسمياً لوزارة التعليم أو هيئة تقويم التعليم والتدريب، والأسئلة ليست من الاختبار الرسمي. لا نضمن درجة معينة في نافس.</p>';
function home(){var n=0,h='<h1><span class="mk">مِداد</span> | استعداد نافس<br><small style="font-size:.5em;color:var(--muted)">الصف السادس الابتدائي</small></h1><p class="lead">تدريب منظّم على الرياضيات والقراءة والعلوم لثلاثة صفوف: دروس قصيرة، أمثلة محلولة، وأسئلة مع شرح لكل إجابة.</p><div class="row"><button class="btn" data-a="prog">تقدمي</button></div><h2 style="margin-top:26px">اختر المادة</h2>';
D.grades[0].sets.forEach(function(s){var b=st.best[s.id];h+='<button class="card" data-a="set" data-id="'+s.id+'"><b>'+s.subject+'</b><small>'+s.questions.length+' سؤالاً'+(b?' • أفضل نتيجة '+b.pct+'%':'')+'</small></button>'});

return h+''+DISC}
function grade(){var g=D.grades.filter(function(x){return x.id===S.id})[0],h='<div class="top"><button class="back" data-a="home">الرئيسية</button></div><h1>'+g.name+'</h1>';
g.sets.forEach(function(s){var b=st.best[s.id];h+='<button class="card" data-a="set" data-id="'+s.id+'"><b>'+s.subject+'</b><small>'+s.questions.length+' سؤالاً'+(b?' • أفضل نتيجة '+b.pct+'%':'')+'</small></button>'});return h}
function setv(){var s=sets[S.id],h='<div class="top"><button class="back" data-a="home">الرئيسية</button></div><h1>'+s.subject+'</h1><div class="tabs" role="tablist">';
[["lesson","الدرس"],["prac","التدريب"],["cards","المراجعة"]].forEach(function(t){h+='<button role="tab" aria-selected="'+(S.tab===t[0])+'" data-a="tab" data-t="'+t[0]+'">'+t[1]+'</button>'});h+='</div>';
if(S.tab==="lesson"){var l=s.lesson;h+='<div class="card"><h2>'+l.title+'</h2><p>'+l.text+'</p><p><b>مثال محلول:</b> '+l.example+'</p></div><button class="btn p b" data-a="tab" data-t="prac">ابدأ التدريب</button>'}
else if(S.tab==="prac"){var b=st.best[s.id];h+='<div class="card"><h2>تدريب سريع</h2><p>بنك من '+s.questions.length+' سؤالاً. كل محاولة تختار أسئلة جديدة مرتبة من السهل إلى الصعب.'+(b?' أفضل نتيجة لك: <b>'+b.pct+'%</b>':'')+'</p><label>المستوى<select id="lv"><option value="0">كل المستويات</option><option value="1">سهل</option><option value="2">متوسط</option><option value="3">صعب</option></select></label><label>عدد الأسئلة<select id="nq"><option value="10">10</option><option value="15" selected>15</option><option value="25">25</option><option value="50">50</option></select></label><label class="chk"><input type="checkbox" id="tm"> مؤقت (45 ثانية لكل سؤال)</label><button class="btn p b" data-a="start">ابدأ</button></div>'}
else{var c=s.lesson.cards[S.ci%s.lesson.cards.length];h+='<p class="lead">اقرأ المفهوم ثم اضغط البطاقة لترى المعلومة.</p><button class="fc" data-a="flip">'+esc(S.fl?c[1]:c[0])+'</button><button class="btn b" data-a="nextc">البطاقة التالية ('+(S.ci%s.lesson.cards.length+1)+'/'+s.lesson.cards.length+')</button>'}
return h}
function quiz(){var q=S.qs[S.i],s=sets[S.id],h='<div class="top"><button class="back" data-a="quit">إنهاء</button><span class="tm" id="clk"></span></div><div class="bar"><i style="width:'+(S.i/S.qs.length*100)+'%"></i></div><p class="lead" style="margin-top:12px">السؤال '+(S.i+1)+' من '+S.qs.length+' • '+LV[q.level]+' • '+esc(q.skill)+'</p>';
var ps=q.passage||s.passage;if(ps)h+='<div class="pass">'+ps+'</div>';h+='<h2>'+esc(q.q)+'</h2>';
q.opts.forEach(function(o,i){var c="opt";if(S.sel!==null){if(o.ok)c+=" ok";else if(i===S.sel)c+=" bad"}h+='<button class="'+c+'" data-a="ans" data-i="'+i+'"'+(S.sel!==null?" disabled":"")+'>'+esc(o.t)+'</button>'});
if(S.sel!==null){var good=S.sel>=0&&q.opts[S.sel].ok;h+='<div class="fb '+(good?"ok":"no")+'"><b>'+(S.sel<0?"انتهى الوقت":good?"إجابة صحيحة":"إجابة غير صحيحة")+'</b><br>'+esc(q.why)+'</div><button class="btn p b" data-a="next">'+(S.i+1===S.qs.length?"عرض النتيجة":"السؤال التالي")+'</button>'}return h}
function result(){var sc=calcScore(S.qs,S.ans),h='<div class="top"><button class="back" data-a="set" data-id="'+S.id+'">رجوع للمادة</button></div><div class="card"><div class="score">'+sc.correct+'/'+sc.total+'</div><p style="text-align:center;margin:6px 0 0">صحيحة: <b>'+sc.correct+'</b> • خاطئة: <b>'+sc.wrong+'</b> • '+sc.pct+'%</p></div>';
var wr=S.qs.filter(function(q,i){return S.ans[i]!==q.a});
if(wr.length){h+='<h2>مراجعة الأخطاء</h2>';S.qs.forEach(function(q,i){if(S.ans[i]!==q.a)h+='<div class="card"><b>'+esc(q.q)+'</b><small>إجابتك: '+(S.ans[i]<0?"لم تجب":esc(q.opts[S.ans[i]].t))+'</small><small>الصحيحة: '+esc(q.opts.filter(function(o){return o.ok})[0].t)+'</small><p style="margin:6px 0 0">'+esc(q.why)+'</p></div>'})}else h+='<p class="lead">أحسنت، لا أخطاء هذه المرة.</p>';
return h+'<div class="row"><button class="btn p" data-a="retry">إعادة بترتيب عشوائي</button><button class="btn" data-a="set" data-id="'+S.id+'">الدرس</button></div>'}
function prog(){var h='<div class="top"><button class="back" data-a="home">الرئيسية</button></div><h1>تقدمي</h1>';
D.grades.forEach(function(g){h+='<h2>'+g.name+'</h2>';g.sets.forEach(function(s){var b=st.best[s.id];h+='<div class="card"><b>'+s.subject+'</b><small>'+(b?'أفضل نتيجة '+b.pct+'% • عدد المحاولات '+(st.tries[s.id]||0):'لم تبدأ بعد')+'</small><div class="bar" style="margin-top:8px"><i style="width:'+(b?b.pct:0)+'%"></i></div></div>'})});
return h+'<button class="btn gh b" data-a="reset">مسح التقدم</button>'}
function draw(){var a=document.getElementById("app");a.innerHTML={home:home,grade:grade,set:setv,quiz:quiz,result:result,prog:prog}[S.v]();if(S.v==="quiz")tick()}
function tick(){if(!S.timer||S.sel!==null)return;S.left=45;var c=document.getElementById("clk");c.textContent=S.left;T=setInterval(function(){S.left--;var e=document.getElementById("clk");if(e)e.textContent=S.left;if(S.left<=0){clearInterval(T);pick(-1)}},1000)}
function pick(i){clearInterval(T);if(S.sel!==null)return;S.sel=i;S.ans[S.i]=i<0?-1:(S.qs[S.i].opts[i].ok?S.qs[S.i].a:i);draw()}
function start(retry){var s=sets[S.id],lv=+S.lv||0,qs=s.questions.filter(function(q){return!lv||q.level===lv});var nn=Math.min(S.nq||15,qs.length);st.seen=st.seen||{};var sn=st.seen[S.id]||[];var fr_=shuf(qs.filter(function(q){return sn.indexOf(q.id)<0}));if(fr_.length<nn){sn=[];fr_=shuf(qs)}qs=fr_.slice(0,nn);st.seen[S.id]=sn.concat(qs.map(function(q){return q.id}));save();qs=retry?shuf(qs):qs.slice().sort(function(a,b){return a.level-b.level});
S.qs=qs.map(function(q){var o=shuf(q.o.map(function(t,i){return{t:t,ok:i===q.a}}));return{id:q.id,skill:q.skill,level:q.level,q:q.q,why:q.why,a:q.a,passage:q.passage,opts:o}});
S.i=0;S.sel=null;S.ans=[];go("quiz")}
function finish(){var sc=calcScore(S.qs,S.ans),b=st.best[S.id];st.tries[S.id]=(st.tries[S.id]||0)+1;if(!b||sc.pct>b.pct)st.best[S.id]={pct:sc.pct,c:sc.correct,t:sc.total};save();go("result")}
document.getElementById("app").addEventListener("click",function(e){var t=e.target.closest("[data-a]");if(!t)return;var a=t.dataset.a,d=t.dataset;
if(a==="home")go("home");else if(a==="grade")go("grade",{id:d.id});else if(a==="set")go("set",{id:d.id,tab:S.tab||"lesson",ci:0,fl:false});
else if(a==="tab"){S.tab=d.t;S.ci=0;S.fl=false;draw()}else if(a==="flip"){S.fl=!S.fl;draw()}else if(a==="nextc"){S.ci++;S.fl=false;draw()}
else if(a==="start"){S.lv=document.getElementById("lv").value;S.timer=document.getElementById("tm").checked;S.nq=+document.getElementById("nq").value||15;start(false)}
else if(a==="retry")start(true);else if(a==="ans")pick(+d.i);
else if(a==="next"){if(S.i+1>=S.qs.length)finish();else{S.i++;S.sel=null;draw();window.scrollTo(0,0)}}
else if(a==="quit")go("set",{id:S.id,tab:"prac"});else if(a==="prog")go("prog");
else if(a==="reset"){st={best:{},tries:{}};save();draw()}});
draw();
};
