async function unlock(input){
  var code=norm(input),enc=new TextEncoder();
  var h=new Uint8Array(await crypto.subtle.digest("SHA-256",enc.encode(code)));
  var id=Array.from(h.slice(0,6)).map(function(x){return x.toString(16).padStart(2,"0");}).join("");
  var e=P.keys.find(function(k){return k.id===id;});if(!e)return null;
  var km=await crypto.subtle.importKey("raw",enc.encode(code),"PBKDF2",false,["deriveKey"]);
  var k=await crypto.subtle.deriveKey({name:"PBKDF2",salt:b64(P.salt),iterations:P.iter,hash:"SHA-256"},km,{name:"AES-GCM",length:256},false,["decrypt"]);
  var raw=await crypto.subtle.decrypt({name:"AES-GCM",iv:b64(e.iv)},k,b64(e.ct));
  var mk=await crypto.subtle.importKey("raw",raw,"AES-GCM",false,["decrypt"]);
  var pt=await crypto.subtle.decrypt({name:"AES-GCM",iv:b64(P.data.iv)},mk,b64(P.data.ct));
  return JSON.parse(new TextDecoder().decode(pt));
}
