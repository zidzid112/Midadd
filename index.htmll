<!doctype html>
<html lang="ar" dir="rtl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>مِداد | نافس — الصف الثالث الابتدائي</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700;12..96,800&family=IBM+Plex+Sans+Arabic:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#e8f3ec;--grid:rgba(15,122,74,.08);--paper:#fbfefc;--ink:#0f2a1c;--muted:#4f6b5a;--rule:#c9dccf;--g:#0f7a4a;--ong:#fff;--mark:#ffd93d;--ok:#12805a;--okbg:#d8f2e4;--bad:#c23434;--badbg:#fbe0e0;
--ar:"IBM Plex Sans Arabic","Segoe UI",Tahoma,Arial,sans-serif;--en:"Bricolage Grotesque","Segoe UI",system-ui,Arial,sans-serif;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0b1a12;--grid:rgba(111,214,160,.07);--paper:#12261b;--ink:#e6f5ec;--muted:#9bb8a7;--rule:#25402f;--g:#6fd6a0;--ong:#0b1a12;--ok:#5fe0a5;--okbg:#12382a;--bad:#ff8686;--badbg:#3d1c26}}
:root[data-theme="dark"]{--bg:#0b1a12;--grid:rgba(111,214,160,.07);--paper:#12261b;--ink:#e6f5ec;--muted:#9bb8a7;--rule:#25402f;--g:#6fd6a0;--ong:#0b1a12;--ok:#5fe0a5;--okbg:#12382a;--bad:#ff8686;--badbg:#3d1c26}
html{scroll-padding-top:env(safe-area-inset-top,0px);background:var(--bg);height:100%}*,*::before,*::after{box-sizing:inherit}
body{margin:0;min-height:100%;background-color:var(--bg);color:var(--ink);font-family:var(--ar);font-size:17px;line-height:1.65;background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:26px 26px;-webkit-text-size-adjust:100%}
button,input{font:inherit;color:inherit}button{cursor:pointer}:focus-visible{outline:3px solid var(--g);outline-offset:2px}
.wrap{max-width:640px;margin:0 auto;padding:20px 16px 48px}.mk{background:linear-gradient(transparent 52%,var(--mark) 52% 90%,transparent 90%);padding:0 2px}
h1{font-size:clamp(30px,8vw,42px);line-height:1.2;margin:14px 0 10px}h2{margin:0 0 8px;font-size:21px}.lead{color:var(--muted);margin:0 0 18px}
.btn{border:1.5px solid var(--ink);background:var(--paper);border-radius:10px;padding:12px 18px;font-weight:600;box-shadow:0 3px 0 var(--ink);min-height:48px;transition:transform .08s,box-shadow .08s}
.btn:active{transform:translateY(3px);box-shadow:none}.btn.p{background:var(--pb,var(--g));color:var(--pt,var(--ong))}.btn.b{display:block;width:100%;margin-top:14px}.btn.gh{box-shadow:none;border-color:var(--rule);color:var(--muted)}
.row{display:flex;gap:10px;flex-wrap:wrap}.row .btn{flex:1 1 150px}
.card{display:block;width:100%;text-align:start;background:var(--paper);border:1.5px solid var(--ink);border-radius:14px;padding:16px;margin-bottom:12px;box-shadow:0 4px 0 var(--ink);animation:rise .3s ease both}
button.card:active{transform:translateY(3px);box-shadow:none}.card small{display:block;color:var(--muted);font-size:14.5px}.card b{font-size:19px}
@keyframes rise{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.top{display:flex;justify-content:space-between;align-items:center}.back{background:none;border:0;color:var(--g);font-weight:700;padding:8px 2px;min-height:44px}
.tabs{display:grid;grid-template-columns:repeat(3,1fr);border:1.5px solid var(--ink);border-radius:10px;overflow:hidden;background:var(--paper);margin:12px 0 16px}
.tabs button{background:none;border:0;padding:11px 2px;font-weight:600;min-height:46px;border-inline-start:1.5px solid var(--ink)}.tabs button:first-child{border-inline-start:0}.tabs [aria-selected=true]{background:var(--mark);color:#1b1b1b}
.bar
